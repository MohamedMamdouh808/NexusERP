// ---------------------------------------------------------------------------
// NexusERP Prisma schema
//
// ---------------------------------------------------------------------------
// NUMERIC CONVENTIONS - Constitution Principle IV
//
// A JavaScript number MUST NOT carry a monetary or quantity value at any point.
// This makes that structural rather than advisory:
//
//   Money, line and document totals, balances, paid amounts
//       -> Decimal @db.Decimal(14, 2)
//   Unit price, unit cost, purchase price, selling price
//       -> Decimal @db.Decimal(14, 4)
//   Quantity: ordered, received, reserved, on-hand, shipped
//       -> Decimal @db.Decimal(14, 3)
//
// A monetary or quantity column MUST NOT use Float. The lint step
// `database/scripts/check-schema-numeric-types.ts` fails when one appears (T110),
// and `backend/scripts/__tests__/schema-numeric-types.spec.ts` proves the checker
// actually detects it (T107). Adding a Float here is therefore a broken build, not a
// code-review opinion.
//
// Money and quantity cross the API as strings, never as JSON numbers.
// ---------------------------------------------------------------------------
//
// TENANT SCOPING - Constitution Principle I (convention for LATER features)
//
// This feature creates no organization-owned table: no `Organization` exists yet, and
// an organization-owned table cannot exist before it (research.md R-016). Every table
// below is GLOBAL product reference data.
//
// The convention that every later feature inherits:
//   1. Every organization-owned table carries `organization_id`, NOT NULL, indexed.
//   2. Every foreign key BETWEEN organization-owned tables is composite over
//      (organization_id, id), never over `id` alone. A single-column foreign key would
//      permit a row to reference a parent in another organization; the composite key
//      makes that structurally impossible.
//   3. Tenant scope is resolved from the session and a verified membership, never from
//      client input.
//   4. A record owned by another organization returns 404, never 403.
//
// TIMESTAMPS: stored as `timestamptz` in UTC. Local time is a presentation concern.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The catalog of permission codes the product uses.
///
/// Global, not organization-scoped: this is the PRODUCT's vocabulary, and a code's
/// meaning is fixed once published. An organization decides which codes its roles
/// grant; it never invents one.
model Permission {
  id String @id @default(uuid()) @db.Uuid

  /// Permission string in `resource.action` form, lowercase. Globally unique:
  /// redefinition of an existing code is forbidden because it would silently change
  /// the meaning of a permission already granted to a role.
  code String @unique @db.VarChar(64)

  /// Owning domain module, e.g. `sales`, `inventory`.
  module String @db.VarChar(32)

  description String @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  grants RoleTemplatePermission[]
  rolePermissions RolePermission[]

  @@map("permissions")
}

/// The definition of one default role.
///
/// A template is the RECIPE, not the grant. An organization's role is materialized
/// from a template by the AccessControl feature; this table never represents a grant
/// to any user and is therefore global.
model RoleTemplate {
  id String @id @default(uuid()) @db.Uuid

  /// Stable machine key, e.g. `administrator`.
  key String @unique @db.VarChar(64)

  name String @db.VarChar(128)

  description String @db.VarChar(255)

  /// Marks a product-defined role. An organization-created role sets this false.
  isSystem Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  permissions RoleTemplatePermission[]

  @@map("role_templates")
}

/// The join between a role template and the permissions it grants.
///
/// The composite primary key IS the duplicate-grant guard: a duplicate insert fails at
/// the database rather than in application code.
model RoleTemplatePermission {
  roleTemplateId String @db.Uuid
  permissionId   String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleTemplateId, permissionId])
  @@index([permissionId])
  @@map("role_template_permissions")
}

/// A user who can sign in to the system. Identified by email, which is unique
/// system-wide (one account per email across all organizations).
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @db.VarChar(255)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  memberships   Membership[]
  sessions      Session[]

  @@map("users")
}

/// A tenant workspace. Contains users through memberships, and owns data such as
/// warehouse, contacts, products, and documents.
model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(128)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  memberships Membership[]
  warehouses  Warehouse[]
  sequences   DocumentSequence[]
  roles       Role[]

  @@map("organizations")
}

/// Links a user to an organization with a role. Determines the user's active tenant
/// context and permissions within that organization. Can be active or deactivated.
model Membership {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  organizationId  String   @db.Uuid
  roleKey         String   @db.VarChar(64)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// A named set of permissions within an organization. Default roles are Administrator,
/// Manager, Sales, Inventory, and Purchasing. organizationId is null for system/default
/// roles that apply globally.
model Role {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique @db.VarChar(64)
  name          String   @db.VarChar(128)
  description   String   @db.VarChar(255)
  isSystem      Boolean  @default(true)
  organizationId String? @db.Uuid
  organization  Organization? @relation(fields: [organizationId], references: [id])

  permissions   RolePermission[]
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
  @@map("roles")
}

/// The join between a role and the permissions it grants within an organization.
/// The composite primary key IS the duplicate-grant guard.
model RolePermission {
  roleId        String @db.Uuid
  permissionId  String @db.Uuid

  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A server-side session tying an opaque session identifier to a user and membership,
/// with idle and absolute expiry timestamps.
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  tokenHash    String   @unique @db.VarChar(255)
  userId       String   @db.Uuid
  membershipId String   @db.Uuid
  expiresAt    DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  lastUsedAt   DateTime @default(now()) @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// A record of a failed login attempt keyed by email and client address, used for
/// rate limiting.
model LoginAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @db.VarChar(255)
  clientAddress String  @db.VarChar(64)
  succeeded    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([email])
  @@map("login_attempts")
}

/// A storage location belonging to an organization. The default warehouse is created
/// during registration.
model Warehouse {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name          String   @db.VarChar(128)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("warehouses")
}

/// A numbering sequence for documents within an organization. Default sequences are
/// created during registration.
model DocumentSequence {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name          String   @db.VarChar(64)
  currentValue  Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("document_sequences")
}
