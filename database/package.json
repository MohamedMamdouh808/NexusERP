{
  "name": "@nexuserp/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:generate": "node ../scripts/with-root-env.mjs prisma generate",
    "db:migrate": "tsx scripts/db-write-guard.ts && node ../scripts/with-root-env.mjs prisma migrate deploy",
    "db:migrate:dev": "tsx scripts/db-write-guard.ts && node ../scripts/with-root-env.mjs prisma migrate dev",
    "db:seed": "tsx scripts/db-write-guard.ts && node ../scripts/with-root-env.mjs tsx prisma/seed.ts",
    "db:reset": "tsx scripts/db-reset-guard.ts && node ../scripts/with-root-env.mjs npx prisma migrate reset --force",
    "check:migrations": "node ../scripts/with-root-env.mjs tsx scripts/check-migration-history.ts",
    "check:rls": "node ../scripts/with-root-env.mjs tsx scripts/check-rls.ts",
    "check:schema-numeric-types": "tsx scripts/check-schema-numeric-types.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}