    "/api/v1/contacts": {
      "get": {
        "operationId": "ContactsController_list",
        "parameters": [
          {
            "description": "Search term across code, name, email, or phone",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Role filter",
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "all",
                "customer",
                "supplier"
              ],
              "type": "string"
            }
          },
          {
            "description": "Archival status filter",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "default": "active",
              "enum": [
                "all",
                "active",
                "archived"
              ],
              "type": "string"
            }
          },
          {
            "description": "Page number",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "description": "Page size",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "description": "Sort column",
            "in": "query",
            "name": "sortBy",
            "required": false,
            "schema": {
              "default": "name",
              "enum": [
                "name",
                "code",
                "createdAt"
              ],
              "type": "string"
            }
          },
          {
            "description": "Sort direction",
            "in": "query",
            "name": "sortOrder",
            "required": false,
            "schema": {
              "default": "asc",
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of contacts"
          },
          "403": {
            "description": "Forbidden (requires contacts.read)"
          }
        },
        "summary": "List contacts with search, filters, sorting, and pagination",
        "tags": [
          "Contacts"
        ]
      },
      "post": {
        "operationId": "ContactsController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContactDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponseDto"
                }
              }
            },
            "description": "Contact successfully created"
          },
          "400": {
            "description": "Validation error (e.g. missing role)"
          },
          "403": {
            "description": "Forbidden (requires contacts.write)"
          },
          "409": {
            "description": "Duplicate contact email within organization"
          }
        },
        "summary": "Create a new customer or supplier contact",
        "tags": [
          "Contacts"
        ]
      }
    },
    "/api/v1/contacts/{id}": {
      "get": {
        "operationId": "ContactsController_findById",
        "parameters": [
          {
            "description": "Contact UUID",
            "in": "path",
            "name": "id",
