              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponseDto"
                }
              }
            },
            "description": "Contact details"
          },
          "403": {
            "description": "Forbidden (requires contacts.read)"
          },
          "404": {
            "description": "Contact not found or cross-tenant"
          }
        },
        "summary": "Get a contact by ID",
        "tags": [
          "Contacts"
        ]
      },
      "put": {
        "operationId": "ContactsController_update",
        "parameters": [
          {
            "description": "Contact UUID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateContactDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponseDto"
                }
              }
            },
            "description": "Updated contact details"
          },
          "400": {
            "description": "Validation error"
          },
          "403": {
            "description": "Forbidden (requires contacts.write)"
          },
          "404": {
            "description": "Contact not found or cross-tenant"
          },
          "409": {
            "description": "Stale version or duplicate email"
          }
        },
        "summary": "Update contact details with optimistic concurrency check",
        "tags": [
          "Contacts"
        ]
      }
    },
