{
  "name": "nexuserp",
  "version": "0.1.0",
  "private": true,
  "description": "NexusERP - multi-tenant modular-monolith ERP SaaS",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @nexuserp/api",
    "dev:web": "npm run dev --workspace @nexuserp/web",
    "build": "npm run build --workspace @nexuserp/shared && npm run build --workspace @nexuserp/api && npm run build --workspace @nexuserp/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @nexuserp/api && npm run test --workspace @nexuserp/web",
    "test:integration": "npm run test:integration --workspace @nexuserp/api",
    "test:coverage": "npm run test:coverage --workspace @nexuserp/api",
    "test:e2e": "npm run test:e2e --workspace @nexuserp/web",
    "db:generate": "npm run db:generate --workspace @nexuserp/api",
    "db:migrate": "npm run db:migrate --workspace @nexuserp/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @nexuserp/api",
    "db:seed": "npm run db:seed --workspace @nexuserp/api",
    "db:reset": "npm run db:reset --workspace @nexuserp/api",
    "openapi:generate": "npm run openapi:generate --workspace @nexuserp/api",
    "openapi:diff": "npm run openapi:diff --workspace @nexuserp/api",
    "check:schema-numeric-types": "npm run check:schema-numeric-types --workspace @nexuserp/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2"
  }
}