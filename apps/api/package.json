{
  "name": "@nexuserp/api",
  "version": "0.1.0",
  "private": true,
  "description": "NexusERP service - NestJS modular monolith",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/with-root-env.mjs nest start --watch",
    "build": "nest build",
    "start": "node scripts/with-root-env.mjs node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && npm run check:schema-numeric-types",
    "check:migrations": "node scripts/with-root-env.mjs tsx scripts/check-migration-history.ts",
    "check:migration-history": "node scripts/with-root-env.mjs tsx scripts/check-migration-history.ts",
    "check:schema-numeric-types": "node scripts/with-root-env.mjs tsx scripts/check-schema-numeric-types.ts",
    "test": "node scripts/with-root-env.mjs jest --selectProjects unit --passWithNoTests",
    "test:unit": "node scripts/with-root-env.mjs jest --selectProjects unit",
    "pretest:integration": "npm run check:migrations",
    "test:integration": "node scripts/with-root-env.mjs jest --selectProjects integration --runInBand",
    "test:coverage": "node scripts/with-root-env.mjs jest --selectProjects unit integration --coverage --runInBand",
    "test:watch": "node scripts/with-root-env.mjs jest --selectProjects unit --watch",
    "db:generate": "node scripts/with-root-env.mjs prisma generate",
    "db:migrate": "node scripts/with-root-env.mjs prisma migrate deploy",
    "db:migrate:dev": "node scripts/with-root-env.mjs prisma migrate dev",
    "db:seed": "node scripts/with-root-env.mjs tsx prisma/seed.ts",
    "db:reset": "node scripts/with-root-env.mjs prisma migrate reset --force",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:diff": "tsx scripts/check-openapi-drift.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.2",
    "@nexuserp/shared": "*",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "pino-http": "^10.3.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
