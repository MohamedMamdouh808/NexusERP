# Normalize line endings in the repository.
#
# `text=auto` lets git detect which files are text and check them out as LF on every
# platform, so a Windows contributor and a Linux one produce identical diffs. Without
# this, a file edited on Windows arrives as CRLF and every line shows as changed.
#
# This matters here because the CI pipeline, the Docker images, and the formatter all
# assume LF. `text=auto eol=lf` makes the repository itself the enforcement point rather
# than relying on each tool to agree.

* text=auto eol=lf

# Binary files must never be line-ending normalized, or they are corrupted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Lockfiles and generated artifacts: normalize, but never rewrite their contents.
package-lock.json text eol=lf

# Documentation authored as Markdown prose.
*.md text eol=lf

# Keep the design system's authored files as UTF-8 text as well.
*.prisma text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf