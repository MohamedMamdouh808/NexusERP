# ---------------------------------------------------------------------------
# NexusERP - example environment configuration
# ---------------------------------------------------------------------------
#
# Copy to `.env` and adjust. `.env` is never committed (FR-004).
# Every value below is a SAFE DEVELOPMENT DEFAULT OR A PLACEHOLDER.
# There are no real secrets in this file.
#
# The backend and the frontend both run on this machine. For local development the
# database is a PostgreSQL 17 installed on this machine; staging uses a hosted Supabase
# project. Nothing here is supplied by a hosting platform.
#
# The full contract - what each variable controls, whether it is a secret, and how
# its value is provided - is
# specs/003-staging-deployment/contracts/environment-variables.md.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
# The API reads its port from the environment, so a supervisor or a second instance
# can move it. The default is 3000.
PORT=3000

# Database                                                   [Secret]
# Local development: a PostgreSQL 17 installed on this machine, reached at
# 127.0.0.1:5432. To run against staging instead, use the Supabase project's connection
# string (Dashboard -> Connect -> "Session pooler"); the session pooler is used for both
# application traffic and migrations, so one URL covers both.
#
# The value below is the documented LOCAL placeholder. It carries the throwaway
# development password the secret scan allows by name, so a copied file still starts
# and `npm run check:secrets` stays meaningful. Replace it before pointing anywhere
# real, and keep the real string in `.env` only.
DATABASE_URL="postgresql://nexuserp:nexuserp_dev_password@127.0.0.1:5432/nexuserp?schema=public"

# Logging
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# CORS - explicit allowlist, never a wildcard (FR-053 security posture)
# The interface's own origin. Vite serves on 5173 by default.
CORS_ORIGINS=http://localhost:5173

# Proxy trust
# How many forwarding-proxy hops to trust when deriving the client's address and
# protocol. OFF by default, and off locally: with trust off the service records the
# socket address, which a caller cannot choose.
#
#   false  trust nothing (the default)
#   1      trust one hop - a single proxy in front of the service
#
# A positive integer is a HOP COUNT, not a switch: `true` is rejected, and so is `0`.
# Setting it wider than the number of proxies that actually exist trusts an entry a
# caller can supply, so the client can present any address it likes to rate limiting
# and to the audit trail. Set it to the real hop count - never higher.
TRUST_PROXY=false

# Sessions - PLACEHOLDER. Not used until the authentication feature ships.
# Generate a value locally (for example `openssl rand -hex 32`) and keep it in `.env`.
SESSION_SECRET=replace-with-at-least-32-random-characters-before-any-deployment

# CSRF - PLACEHOLDER. Not used until the authentication feature ships.
CSRF_SECRET=replace-with-at-least-32-random-characters-before-any-deployment

# ---------------------------------------------------------------------------
# Required in production only
# ---------------------------------------------------------------------------
# NODE_ENV=production
# LOG_LEVEL=info
# CORS_ORIGINS=https://your-production-domain.example
# TRUST_PROXY=false
