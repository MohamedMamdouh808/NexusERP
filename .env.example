# ---------------------------------------------------------------------------
# NexusERP - example environment configuration
#
# Copy to `.env` and adjust. `.env` is never committed (FR-004).
# Every value below is a SAFE DEVELOPMENT DEFAULT OR A PLACEHOLDER.
# There are no real secrets in this file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# Database
# Points at the `db` container defined in docker-compose.yml.
# Hostname `db` is the Compose service name; use `localhost` when running
# the service on the host against a container-published port.
DATABASE_URL="postgresql://nexuserp:nexuserp_dev_password@db:5432/nexuserp?schema=public"

# Logging
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# CORS - explicit allowlist, never a wildcard (FR-053 security posture)
CORS_ORIGINS=http://localhost:5173

# Sessions - PLACEHOLDER. Not used until the authentication feature ships.
# Replace before any deployment that serves real traffic.
SESSION_SECRET=replace-with-at-least-32-random-characters-before-any-deployment

# CSRF - PLACEHOLDER. Not used until the authentication feature ships.
CSRF_SECRET=replace-with-at-least-32-random-characters-before-any-deployment

# ---------------------------------------------------------------------------
# Required in production only
# ---------------------------------------------------------------------------
# NODE_ENV=production
# LOG_LEVEL=info
# CORS_ORIGINS=https://your-production-domain.example